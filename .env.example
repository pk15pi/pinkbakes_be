# PinkBakes backend environment example
# Copy to .env (or set in your process manager). Do not commit real secrets.

FRONTEND_URL=https://pinkbakes.com
# Public absolute site URL used in robots.txt, sitemap.xml, and JSON-LD.
# Defaults to FRONTEND_URL. Prefer https://pinkbakes.com in production.
PUBLIC_SITE_URL=https://pinkbakes.com
# Optional; used in Organization schema telephone when set.
PUBLIC_CONTACT_PHONE=6033430700
# Production: Firebase Hosting rewrites /sitemap.xml to Cloud Function sitemap
# which proxies to this app's /sitemap.xml. Set functions/.env API_ORIGIN to this
# API host. Keep PUBLIC_SITE_URL=https://pinkbakes.com so <loc> URLs are correct.
# Static FE public/robots.txt already declares Sitemap: https://pinkbakes.com/sitemap.xml
# (Django /robots.txt remains available on the API origin if needed).

# Email (leave EMAIL_HOST empty to use console backend)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=pinkbakes@pinkbakes.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=pinkbakes@pinkbakes.com

# Payments / Razorpay
# When PAYMENT_ENABLED=false (default), the API still creates a local deterministic
# gateway_order_id so checkout + signature verify tests work with settings KEY_SECRET.
# Set PAYMENT_ENABLED=true and real Razorpay keys to call the live Orders API.
PAYMENT_GATEWAY=razorpay
PAYMENT_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# Inventory
DEFAULT_LOW_STOCK_THRESHOLD=5

# Coupons
# false (default): unpaid cancel voids redemption but per-user usage still counts.
COUPON_RESTORE_ON_CANCEL=false


# Notifications
NOTIFICATION_EMAIL_ENABLED=true
# Optional SMS (leave empty to skip / stub)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional WhatsApp (leave empty to skip / stub)
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
